# Copy this file to .env and fill in real values. Never commit .env.
# See docs/ZERODHA_API_NOTES.md for the reasoning behind every Zerodha-related
# variable below.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string   # used to encrypt broker tokens at rest
TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://trading:trading@db:5432/trading_platform

# ---------------------------------------------------------------------------
# Redis (pub/sub for market data fan-out, task queue, caching)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Zerodha Kite Connect
# ---------------------------------------------------------------------------
# Created at https://developers.kite.trade
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Must exactly match the IP whitelisted at developers.kite.trade -> Profile ->
# IP Whitelist. Order placement is REJECTED from any other IP as of the SEBI/
# NSE algo-trading circular in force since 1 Apr 2026. The exchange allows
# only one change per calendar week, so this is a manual, deliberate value,
# never auto-managed by the app. See docs/ZERODHA_API_NOTES.md section 4.
ZERODHA_STATIC_IP=
# Where Kite redirects after login with ?request_token=... (must match the
# redirect URL registered on the app).
ZERODHA_REDIRECT_URL=http://localhost:8000/api/v1/broker/callback
# Requires the paid "Connect" plan (₹500/mo) for live quotes/historical data.
# Backtesting on already-cached candles works without it.

# ---------------------------------------------------------------------------
# Risk limits (internal ceiling, intentionally tighter than Kite's own limits
# — see docs/ZERODHA_API_NOTES.md section 4)
# ---------------------------------------------------------------------------
RISK_MAX_ORDERS_PER_SECOND=5
RISK_MAX_ORDERS_PER_MINUTE=200
RISK_MAX_ORDERS_PER_DAY=1000
RISK_MAX_LIVE_ORDER_VALUE_INR=100000

# ---------------------------------------------------------------------------
# Live engine (Phase 0)
# ---------------------------------------------------------------------------
# Advisory colour bands (ms) for the "⚡ x.x ms" indicator — INTERNAL latency,
# not the broker round-trip.
LATENCY_THRESHOLD_EXCELLENT_MS=1
LATENCY_THRESHOLD_FAST_MS=5
LATENCY_THRESHOLD_MODERATE_MS=20
LATENCY_THRESHOLD_HIGH_MS=100
# Kite WebSocket market-data ticker. Off by default; needs a connected
# broker session. Empty LIVE_TICKER_INSTRUMENTS => the NIFTY 50 watchlist.
LIVE_TICKER_ENABLED=false
LIVE_TICKER_MODE=full
LIVE_TICKER_INSTRUMENTS=
LIVE_TICKER_MAX_INSTRUMENTS=500
LIVE_TICKER_STALE_SECONDS=5
CIRCUIT_BREAKER_STALE_HALT_SECONDS=15

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws

# ---------------------------------------------------------------------------
# Fundamentals data provider (Stock Intelligence panel)
#   yfinance  - default; free, no key, Yahoo Finance (INFY.NS etc.)
#   indianapi - indianapi.in (deeper Indian data incl. promoter/FII/DII;
#               ~500 calls/month on the free tier, needs a key)
#   none      - disable; the panel shows "provider not configured"
# ---------------------------------------------------------------------------
FUNDAMENTALS_PROVIDER=yfinance
FUNDAMENTALS_API_KEY=
FUNDAMENTALS_API_BASE=

# ---------------------------------------------------------------------------
# Research assistant (the "Ask AI" chat) — Anthropic / Claude
#   Get a key at https://console.anthropic.com -> Settings -> API Keys.
#   Without ANTHROPIC_API_KEY the assistant just shows "not configured".
#   The backend must be RESTARTED after adding this (settings are cached).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
